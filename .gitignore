# Terraform
*.tfstate
*.tfstate.backup
*.tfvars
!terraform.tfvars.example
.terraform/
.terraform.lock.hcl

# Environment
.env
.env.local
*.env

# Secrets
**/secrets/
**/*-key.json
**/*-credentials.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/
*.egg

# Node
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.idea/
.vscode/
*.code-workspace

# Benchmark results (keep .gitkeep)
benchmarks/results/*.csv
benchmarks/results/*.json
benchmarks/results/*.png
!benchmarks/results/.gitkeep

# Kubernetes secrets
**/secret*.yaml
!**/secret*-example.yaml

# Logs
*.log

# Model weights (never commit)
*.bin
*.safetensors
*.gguf
*.pt
*.pth
